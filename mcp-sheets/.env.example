# Secreto que va dentro de la URL del conector. Mínimo 24 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_SECRET=

# Clave de la cuenta de servicio de Google. El JSON entero, o el JSON en base64.
# Base64:  base64 -w0 clave.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# Puerto de escucha (Coolify lo mapea solo)
PORT=3100
